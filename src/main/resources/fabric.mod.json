	"authors": [
		"BIG_Gamba"
	],
	"contact": {
		"homepage": "https://wiki.primeblocks.net/"
	},
	"license": "MIT",
	"icon": "assets/primeitemvalue/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"net.primeblocks.itemvalue.PrimeItemValueClient"
		]
	},
	"mixins": [
		"primeitemvalue.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"fabric-api": "*",
		"minecraft": "~26.3",
		"java": ">=25"
	}
}
